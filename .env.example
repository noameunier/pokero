# Racine — variables pour Docker Compose de production.
# Copier vers .env (non commité) et adapter : cp .env.example .env

POSTGRES_USER=pokero
POSTGRES_PASSWORD=change-me-with-a-long-random-password
POSTGRES_DB=pokero
DATABASE_URL=postgresql://pokero:change-me@db:5432/pokero?schema=public

# Secrets applicatifs : générer avec `openssl rand -hex 32`.
SESSION_SECRET=change-me-64-hex
TOKEN_PEPPER=change-me-64-hex
PIN_PEPPER=change-me-64-hex

APP_BASE_URL=https://pokero.noameunier.fr
COOKIE_SECURE=true
COOKIE_DOMAIN=
TRUST_PROXY=true
LOG_LEVEL=info

# Aucun SMTP n'est configuré en production pour l'instant (Mailpit en local uniquement).
# La vérification d'email reste donc désactivée jusqu'à la mise en place d'un vrai SMTP.
EMAIL_VERIFICATION_REQUIRED=false
ADMIN_EMAILS=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Pokero <no-reply@pokero.noameunier.fr>"

SEED_DEMO=false
