# API — exemple de configuration locale
# Copier vers apps/api/.env puis adapter. Ne jamais committer .env.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=debug

# PostgreSQL local (docker-compose.dev.yml, port 5433)
DATABASE_URL=postgresql://pokero:pokero_dev_only@127.0.0.1:5433/pokero?schema=public

# Secrets — générer avec: openssl rand -hex 32
SESSION_SECRET=change-me-64-hex
TOKEN_PEPPER=change-me-64-hex
PIN_PEPPER=change-me-64-hex

# URL publique de l'application (liens email, redirections)
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Vérification email (false en dev sans SMTP)
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Pokero <no-reply@pokero.local>"

# Administration (emails séparés par des virgules)
ADMIN_EMAILS=

# Jeu de démonstration (jamais en production)
SEED_DEMO=false
